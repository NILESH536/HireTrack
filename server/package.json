{
  "name": "hirectrack-server",
  "version": "1.0.0",
  "description": "HireTrack Campus Placement Platform - Backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node src/seeds/seedData.js",
    "test": "jest --passWithNoTests",
    "db:sync": "node scripts/sync-neon.js",
    "db:migrate": "npx sequelize-cli db:migrate",
